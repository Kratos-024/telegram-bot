generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
  output = "../../../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = "postgresql://postgres:hellocha@db.cqhgzsmhwxraqgneltle.supabase.co:5432/postgres"
}

model User {
  id        BigInt    @id @default(autoincrement())
  email     String    @unique
  password  String
  balance   Float     @default(0)
  createdAt DateTime  @default(now())
  chatId    String?   @unique

  purchases Purchase[]
  matchEntries MatchEntry[]
  matchHistory MatchHistory[]
}

model Match {
  id                 Int       @id @default(autoincrement())
  imageFileId        String?
  gameId             String?
  matchPassword      String?
  gameName           String
  matchName          String
  netPrizePool       Float    @default(0)         // Changed from Int to Float
  price              Float                         // Entry fees
  perKillPoint       Float     @default(0)         // Per kill reward
  firstPrize         Float     @default(0)
  secondPrize        Float     @default(0)
  thirdPrize         Float     @default(0)
  entryFees          Float                         // Entry fees for joining
  totalSeats         Int      
  time               String
  date               DateTime  @default(now())
  status             String    @default("upcoming") // upcoming, ongoing, completed, cancelled
  isDeleted          Boolean   @default(false)      // Soft delete flag

  purchases Purchase[]
  matchEntries MatchEntry[]
}

model Purchase {
  id        Int      @id @default(autoincrement())
  userId    BigInt
  matchId   Int
  createdAt DateTime @default(now())  
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  match     Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)

  @@unique([userId, matchId])
}

model MatchEntry {
  id        Int      @id @default(autoincrement())
  userId    BigInt
  matchId   Int
  amountPaid Float
  createdAt DateTime @default(now())
  
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  match     Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)

  @@unique([userId, matchId])
}

model MatchHistory {
  id                 Int       @id @default(autoincrement())
  userId             BigInt
  originalMatchId    Int       // Reference to original match
  gameName           String
  matchName          String
  amountPaid         Float
  prizeWon           Float     @default(0)
  killCount          Int       @default(0)
  position           Int?      // Final position in match (1st, 2nd, etc.)
  type               String    // "Purchase" or "Entry"
  status             String    @default("participated") // "participated", "won", "lost", "cancelled"
  matchDate          DateTime
  completedAt        DateTime?
  createdAt          DateTime  @default(now())
  
  // Additional match details preserved
  entryFees          Float
  totalSeats         Int
  netPrizePool       Float
  perKillPoint       Float
  firstPrize         Float
  secondPrize        Float
  thirdPrize         Float
  matchTime          String
  
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([userId])
  @@index([originalMatchId])
  @@index([matchDate])
}