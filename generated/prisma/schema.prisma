generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
  output        = "../../../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = "postgresql://neondb_owner:npg_gZvyrqi5bF4U@ep-red-sun-a8h634uu-pooler.eastus2.azure.neon.tech/neondb?sslmode=require&channel_binding=require"
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  balance   Float    @default(0)
  createdAt DateTime @default(now())
  chatId    String   @unique

  purchases    Purchase[]
  matchEntries MatchEntry[]
}

model Match {
  id                 Int      @id @default(autoincrement())
  imageFileId        String?
  gameName           String
  matchName          String
  platformShare      Int?
  platformShareTotal Float?   @default(0.3)
  netPrizePool       Int?     @default(0)
  price              Float // This will be the entry fees
  perKillPoint       Float    @default(0)
  firstPrize         Float    @default(0)
  secondPrize        Float    @default(0)
  thirdPrize         Float    @default(0)
  entryFees          Float // Entry fees for joining the match
  totalSeats         Int
  time               String
  date               DateTime @default(now())

  purchases    Purchase[]
  matchEntries MatchEntry[]
}

model Purchase {
  id        Int      @id @default(autoincrement())
  userId    Int
  matchId   Int
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
  match     Match    @relation(fields: [matchId], references: [id])

  @@unique([userId, matchId])
}

model MatchEntry {
  id         Int      @id @default(autoincrement())
  userId     Int
  matchId    Int
  amountPaid Float
  createdAt  DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id])
  match Match @relation(fields: [matchId], references: [id])

  @@unique([userId, matchId])
}
